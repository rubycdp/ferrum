module Ferrum
  class Deadline
    THREAD_KEY: Symbol

    def self.current: () -> Deadline?

    def self.within: [T] ((Deadline | Numeric) timeout) { () -> T } -> T

    def self.suspend: [T] () { () -> T } -> T

    def self.after: (Numeric seconds) -> Deadline

    def self.wrap: (Deadline | Numeric timeout) -> Deadline

    def initialize: (Float at) -> void

    def min: (Deadline other) -> Deadline

    def remaining: () -> Float

    def expired?: () -> bool

    attr_reader at: Float
  end
end
