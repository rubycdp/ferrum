module Ferrum
  class Network
    module RequestParams
      @request: Hash[String, untyped]

      def url: () -> String

      def url_fragment: () -> String?

      def method: () -> String

      def headers: () -> ::Hash[String, String]

      def body: () -> String?

      %a{deprecated} def post_data: () -> String?
    end
  end
end
