module Ferrum
  class Network
    class Error
      attr_writer canceled: bool?

      attr_writer time: Time?

      attr_accessor id: String?

      attr_accessor url: String?

      attr_accessor type: String?

      attr_accessor error_text: String?

      attr_writer monotonic_time: Float?

      attr_accessor description: String?

      def canceled?: () -> bool?

      def time: () -> Time?

      def timestamp=: (Float value) -> Float
    end
  end
end
