module Ferrum
  class Network
    class Request
      def initialize: (untyped params) -> void

      def id: () -> untyped

      def resource_type: () -> String

      def resource_type?: (String | Symbol value) -> bool

      %a{deprecated}
      def type: () -> String

      %a{deprecated}
      def type?: (String | Symbol value) -> bool

      def frame_id: () -> untyped

      def url: () -> untyped

      def url_fragment: () -> untyped

      def method: () -> untyped

      def headers: () -> untyped

      def time: () -> untyped

      def post_data: () -> untyped

      alias body post_data
    end
  end
end
