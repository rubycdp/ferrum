module Ferrum
  class Mouse
    BUTTON_MASKS: ::Hash[String, ::Integer]

    @page: Page
    @x: ::Numeric
    @y: ::Numeric
    @buttons: ::Integer

    def initialize: (Page page) -> void

    def scroll_by: (?x: ::Numeric, ?y: ::Numeric) -> self

    def scroll_to: (?x: ::Numeric?, ?y: ::Numeric?) -> self

    def click: (x: ::Numeric, y: ::Numeric, ?delay: ::Numeric, ?navigation_wait: (::Numeric | false), ?timeout: (::Numeric | Deadline)?, ?button: Symbol, ?count: ::Integer, ?modifiers: (::Array[::Symbol] | ::Integer)) -> self

    def down: (?button: Symbol, ?count: ::Integer, ?modifiers: (::Array[::Symbol] | ::Integer), ?navigation_wait: (::Numeric | false), ?timeout: (::Numeric | Deadline)?) -> self

    def up: (?button: Symbol, ?count: ::Integer, ?modifiers: (::Array[::Symbol] | ::Integer), ?navigation_wait: (::Numeric | false), ?timeout: (::Numeric | Deadline)?) -> self

    def move: (x: ::Numeric, y: ::Numeric, ?steps: ::Integer, ?modifiers: (::Array[::Symbol] | ::Integer)?, ?timeout: (::Numeric | Deadline)?) -> self

    private

    def mouse_event: (type: String, ?button: Symbol, ?count: ::Integer, ?modifiers: (::Array[::Symbol] | ::Integer)?, ?navigation_wait: (::Numeric | false), ?timeout: (::Numeric | Deadline)?) -> Hash[String, untyped]

    def modifiers_mask: ((::Array[::Symbol] | ::Integer)? modifiers) -> ::Integer

    def validate_button: (Symbol button) -> String

    def pressed_button: () -> String

    def register_event_button: (String type, String button) -> ::Integer
  end
end
