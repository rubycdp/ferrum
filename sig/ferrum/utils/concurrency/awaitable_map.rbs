module Ferrum
  module Utils
    module Concurrency
      class AwaitableMap[K, V]
        @mutex: Mutex
        @condition: ConditionVariable
        @map: Hash[K, V]
        @expected: Hash[K, bool]
        @closed: bool

        def initialize: () -> void

        def []: (K key) -> V?

        def []=: (K key, V value) -> V

        def expect: (K key) -> K

        def expecting?: (K key) -> bool

        def fulfill: (K key, V value) -> bool

        def delete: (K key) -> V?

        def close: () -> void

        def key?: (K key) -> bool

        def to_h: () -> Hash[K, V]

        def values: () -> Array[V]

        def await: (K key, (Numeric | Deadline) timeout) -> V?

        def inspect: () -> String
      end
    end
  end
end
