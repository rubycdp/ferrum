module Ferrum
  module Interceptable
    def on: (:request) { (Network::InterceptedRequest, Integer, Integer) -> void } -> Integer
          | (:response) { (Network::Exchange, Integer, Integer) -> void } -> Integer
          | (:auth) { (Network::AuthRequest, Integer, Integer) -> void } -> Integer
          | (Symbol | String name) { (*untyped) -> void } -> Integer

    def off: (Symbol | String name, Integer id) -> void

    def subscribed?: (String event) -> bool
  end
end
