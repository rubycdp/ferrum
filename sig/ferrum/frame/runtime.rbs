module Ferrum
  class CyclicObject
    include Singleton

    def inspect: () -> ::String
  end

  class Frame
    module Runtime
      INTERMITTENT_ATTEMPTS: untyped

      INTERMITTENT_SLEEP: untyped

      DEEP_SERIALIZATION: ::Hash[Symbol, untyped]

      UNSERIALIZABLE_NUMBERS: ::Hash[String, Float]

      def evaluate: (untyped expression, *untyped args) -> untyped

      def evaluate_async: (untyped expression, untyped wait, *untyped args) -> untyped

      def execute: (untyped expression, *untyped args) -> true

      def evaluate_func: (untyped expression, *untyped args, ?on: untyped?) -> untyped

      def evaluate_on: (node: untyped, expression: untyped, ?by_value: bool, ?wait: ::Integer) -> untyped

      private

      def call: (expression: untyped, ?arguments: untyped, ?on: untyped?, ?wait: ::Integer, ?handle: bool, **untyped options) -> untyped

      def handle_error: (untyped response) -> (nil | untyped)

      def handle_response: (Hash[String, untyped] response) -> untyped

      def deserialize: (Hash[String, untyped] serialized, ?Hash[Integer, Hash[String, untyped]] references, ?Array[Integer] path) -> untyped

      def resolve_node: (Node node) -> String

      def resolve_node_options: () -> ::Hash[Symbol, Integer]

      def prepare_args: (untyped args) -> untyped

      def cyclic_object: () -> CyclicObject
    end
  end
end
