module Ferrum
  class Frame
    module DOM
      WAIT_INTERVAL: ::Float
      WAIT_FOR_SELECTOR_DEPRECATED: String
      SCRIPT_SRC_TAG: ::String

      SCRIPT_TEXT_TAG: ::String

      STYLE_TAG: ::String

      LINK_TAG: ::String

      %a{deprecated} def current_url: () -> untyped

      %a{deprecated} def current_title: () -> untyped

      def doctype: () -> untyped

      def html: () -> String

      %a{deprecated} def body: () -> String

      def xpath: (untyped selector, ?within: untyped?) -> untyped

      def at_xpath: (untyped selector, ?within: untyped?) -> untyped

      def css: (untyped selector, ?within: untyped?) -> untyped

      def at_css: (untyped selector, ?within: untyped?) -> untyped

      def wait_css: (String selector, ?within: Node?, ?timeout: (::Numeric | Deadline)?, ?interval: ::Numeric) -> Node?

      def wait_css!: (String selector, ?within: Node?, ?timeout: (::Numeric | Deadline)?, ?interval: ::Numeric) -> Node

      def wait_xpath: (String selector, ?within: Node?, ?timeout: (::Numeric | Deadline)?, ?interval: ::Numeric) -> Node?

      def wait_xpath!: (String selector, ?within: Node?, ?timeout: (::Numeric | Deadline)?, ?interval: ::Numeric) -> Node

      %a{deprecated} def wait_for_selector: (?css: String?, ?xpath: String?, ?within: Node?, ?timeout: (::Numeric | Deadline), ?interval: ::Numeric) -> Node?

      def add_script_tag: (?url: untyped?, ?path: untyped?, ?content: untyped?, ?type: ::String) -> untyped

      def add_style_tag: (?url: untyped?, ?path: untyped?, ?content: untyped?) -> untyped
    end
  end
end
