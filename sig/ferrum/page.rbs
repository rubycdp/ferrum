module Ferrum
  class Page
    NAVIGATION_WAIT: ::Float
    WAIT_INTERVAL: ::Float
    WAIT_FOR_NAVIGATION_DEPRECATED: String
    WAIT_FOR_RELOAD_DEPRECATED: String

    extend Forwardable

    include Animation
    include Screenshot
    include Screencast
    include Frames
    include Navigation
    include Stream
    include Interceptable

    attr_reader context_id: String?
    attr_reader target_id: String
    attr_reader idle: Concurrency::Cell
    attr_reader tracing: Page::Tracing
    attr_reader mouse: Mouse
    attr_reader keyboard: Keyboard
    attr_reader network: Network
    attr_reader console: Console
    attr_reader accessibility: Accessibility
    attr_reader headers: Headers
    attr_reader cookies: Page::Cookies
    attr_reader downloads: Downloads
    attr_reader document_version: ::Integer
    attr_reader client: (Client | SessionClient)

    @client: (Client | SessionClient)
    @javascript: bool
    @context_id: String?
    @target_id: String
    @options: Browser::Options
    @frames: ::Concurrent::Map[String, Frame]
    @main_frame: Frame
    @idle: Concurrency::Cell
    @mouse: Mouse
    @keyboard: Keyboard
    @headers: Headers
    @cookies: Page::Cookies
    @network: Network
    @console: Console
    @tracing: Page::Tracing
    @downloads: Downloads
    @document_version: ::Integer

    def initialize: ((Client | SessionClient) client, context_id: String?, target_id: String, ?proxy: { host: String, port: ::Integer, user: String?, password: String? }?) -> void

    def context: () -> Context?

    def close: () -> nil

    def activate: () -> nil

    def close_connection: () -> void

    def set_viewport: (?width: ::Integer, ?height: ::Integer, ?scale_factor: ::Float, ?mobile: bool?) -> nil

    def resize: (?width: ::Numeric?, ?height: ::Numeric?, ?fullscreen: bool) -> nil

    def position: () -> Hash[String, ::Integer]

    def position=: (Hash[Symbol, ::Integer] bounds) -> Hash[String, untyped]

    def window_bounds: () -> Hash[String, (::Integer | String)]

    def window_bounds=: (Hash[Symbol, (::Integer | String)] bounds) -> Hash[String, untyped]

    def bypass_csp=: (bool enabled) -> bool

    %a{deprecated} def bypass_csp: (?enabled: bool) -> bool

    def javascript=: (bool enabled) -> bool

    def javascript?: () -> bool

    %a{deprecated} def disable_javascript: () -> Hash[String, untyped]

    def evaluate_on_new_document: (String source, ?world_name: String?, ?run_immediately: bool) -> String

    def remove_script_on_new_document: (String identifier) -> nil

    def window_id: () -> ::Integer

    def command: (String method, ?slowmoable: bool, ?timeout: (::Numeric | Deadline)?, **untyped) -> Hash[String, untyped]

    def on: (:dialog) { (Dialog) -> void } -> Integer
          | (:console) { (Console::Message) -> void } -> Integer
          | (:request) { (Network::InterceptedRequest) -> void } -> Integer
          | (:response) { (Network::Exchange) -> void } -> Integer
          | (:auth) { (Network::AuthRequest) -> void } -> Integer
          | ((Symbol | String) event) { (Hash[String, untyped], Integer, Integer) -> void } -> Integer

    def off: ((Symbol | String) event, Integer id) -> void

    def use_proxy?: () -> boolish

    def use_authorized_proxy?: () -> boolish

    def timeout: () -> ::Numeric

    def timeout=: (::Numeric value) -> ::Numeric

    def wait_until: [T] (?timeout: (::Numeric | Deadline)?, ?interval: ::Numeric) { () -> T } -> T?

    def wait_until!: [T] (?timeout: (::Numeric | Deadline)?, ?interval: ::Numeric) { () -> T } -> T

    private

    def subscribe: () -> void

    def build_chain: (Symbol name) -> Interceptable::Chain[untyped]

    def accept_dialog: (Dialog dialog) -> Hash[String, untyped]

    def prepare_page: () -> void

    def document_node_id: (?async: bool) -> (::Integer | bool)

    def proxy=: ({ host: String, port: ::Integer, user: String?, password: String? }? proxy) -> void
  end
end
