module Ferrum
  class Context
    POSITION: ::Array[:first | :last]
    WINDOWS_DEPRECATED: String

    attr_reader id: String

    def targets: () -> Hash[String, Target]

    @id: String
    @implicit: bool
    @client: Client
    @contexts: Contexts
    @targets: Concurrency::AwaitableMap[String, Target]
    @page_waiters: ::Array[[String?, Concurrency::Cell]]
    @page_waiters_mutex: ::Mutex
    @default_target: Target?
    @cookies: Cookies

    def initialize: (Client, Contexts, String, ?implicit: bool) -> void

    def implicit?: () -> bool

    def default_target: () -> Target

    def cookies: () -> Cookies

    def page: () -> Page

    def pages: () ?{ (Target) -> boolish } -> ::Array[Page]

    def workers: () -> ::Array[Worker]

    def service_workers: () -> ::Array[Target]

    %a{deprecated} def windows: (?(:first | :last)?, ?::Integer) -> ::Array[Page]

    def await_page: (?opener: Page?, ?timeout: (::Numeric | Deadline)?) { () -> void } -> Page?

    def await_page!: (?opener: Page?, ?timeout: (::Numeric | Deadline)?) { () -> void } -> Page

    def create_page: (**untyped options) -> Page

    def create_target: () -> Target

    def add_target: (params: Hash[String, untyped], ?session_id: String?, ?attached: bool) -> Target

    def update_target: (String target_id, Hash[String, untyped] params) -> void

    def delete_target: (String target_id) -> Target?

    def attach_target: (String target_id) -> Target

    def find_target: () { (Target) -> bool } -> Target?

    def close_targets_connection: () -> void

    def dispose: () -> bool?

    def target: (String target_id) -> Target?

    def target?: (String target_id) -> bool

    def inspect: () -> ::String

    private

    def announce_page: (Target target) -> void
  end
end
