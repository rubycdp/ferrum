module Ferrum
  class Headers
    OVERRIDES: { user_agent: String, accept_language: String }

    @page: Page
    @headers: ::Hash[String, String]

    def initialize: (Page page) -> void

    def get: () -> ::Hash[String, String]

    def set: (::Hash[String, String] headers) -> true

    def clear: () -> true

    def add: (::Hash[String, String] headers, ?permanent: bool) -> true
  end
end
