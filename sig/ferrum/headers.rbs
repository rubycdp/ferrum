module Ferrum
  class Headers
    OVERRIDES: { user_agent: String, accept_language: String }
    OVERRIDES_DEPRECATED: String

    @page: Page
    @headers: ::Hash[String, String]

    def initialize: (Page page) -> void

    def get: () -> ::Hash[String, String]

    def set: (::Hash[String, String] headers) -> nil

    def clear: () -> nil

    def add: (::Hash[String, String] headers) -> nil

    private

    def reset_overrides: (?keep: ::Hash[String, String]) -> void
  end
end
